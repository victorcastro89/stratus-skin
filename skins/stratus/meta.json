{
	"name": "Stratus",
	"author": "Victor Faria",
	"license": "Creative Commons Attribution-ShareAlike 3.0",
	"license-url": "http://creativecommons.org/licenses/by-sa/3.0/",
	"extends": "elastic",
	"localization": true,
	"config": {
		"supported_layouts": ["widescreen"],
		"jquery_ui_colors_theme": "bootstrap",
		"embed_css_location": "/styles/embed.css",
		"editor_css_location": "/styles/embed.css",
		"dark_mode_support": true,
		"media_browser_css_location": "none",
		"additional_logo_types": ["dark", "small", "small-dark"]
	},
	"meta": {
		"viewport": "width=device-width, initial-scale=1.0, shrink-to-fit=no, maximum-scale=1.0",
		"theme-color": "#5c6bc0",
		"msapplication-navbutton-color": "#5c6bc0"
	},
	"links": {
		"shortcut icon": { "href": "/images/favicon/favicon.ico" },
		"icon": [
			{ "type": "image/svg+xml", "href": "/images/favicon/favicon.svg" },
			{ "type": "image/png", "sizes": "96x96", "href": "/images/favicon/favicon-96x96.png" }
		],
		"apple-touch-icon": { "sizes": "180x180", "href": "/images/favicon/apple-touch-icon.png" },
		"manifest": { "href": "/images/favicon/site.webmanifest" }
	}
}
